{
  "name": "Turma",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da turma (ex: 3\u00ba Ano A)"
    },
    "ano_letivo": {
      "type": "string",
      "description": "Ano letivo (ex: 2025)"
    },
    "periodo": {
      "type": "string",
      "enum": [
        "matutino",
        "vespertino",
        "noturno",
        "integral"
      ],
      "description": "Per\u00edodo da turma"
    },
    "nivel": {
      "type": "string",
      "enum": [
        "fundamental_1",
        "fundamental_2",
        "medio",
        "superior",
        "tecnico"
      ],
      "description": "N\u00edvel de ensino"
    },
    "instituicao": {
      "type": "string",
      "description": "Nome da institui\u00e7\u00e3o de ensino"
    },
    "ativa": {
      "type": "boolean",
      "default": true,
      "description": "Se a turma est\u00e1 ativa"
    }
  },
  "required": [
    "nome",
    "ano_letivo"
  ]
}