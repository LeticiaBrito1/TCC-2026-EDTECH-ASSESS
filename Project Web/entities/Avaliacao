{
  "name": "Avaliacao",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da avalia\u00e7\u00e3o"
    },
    "disciplina_id": {
      "type": "string",
      "description": "ID da disciplina vinculada"
    },
    "turma_id": {
      "type": "string",
      "description": "ID da turma vinculada"
    },
    "data_aplicacao": {
      "type": "string",
      "format": "date",
      "description": "Data de aplica\u00e7\u00e3o da prova"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "publicada",
        "aplicada",
        "corrigida"
      ],
      "default": "rascunho",
      "description": "Status da avalia\u00e7\u00e3o"
    },
    "questoes_ids": {
      "type": "array",
      "description": "IDs das quest\u00f5es selecionadas",
      "items": {
        "type": "string"
      }
    },
    "pesos": {
      "type": "array",
      "description": "Pesos de cada quest\u00e3o (mesmo \u00edndice de questoes_ids)",
      "items": {
        "type": "number"
      }
    },
    "total_pontos": {
      "type": "number",
      "description": "Total de pontos da avalia\u00e7\u00e3o"
    },
    "num_versoes": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero de vers\u00f5es da prova"
    },
    "embaralhar_questoes": {
      "type": "boolean",
      "default": false,
      "description": "Se deve embaralhar a ordem das quest\u00f5es"
    },
    "embaralhar_alternativas": {
      "type": "boolean",
      "default": false,
      "description": "Se deve embaralhar a ordem das alternativas"
    },
    "instrucoes": {
      "type": "string",
      "description": "Instru\u00e7\u00f5es para os alunos"
    }
  },
  "required": [
    "titulo",
    "disciplina_id",
    "turma_id"
  ]
}