# =============================================================================
# .env.production.example
# Copie para o RAIZ do projeto como .env.production e preencha os valores.
# Este arquivo é usado pelo Vite no momento do build.
# =============================================================================

# URL do backend — substitua pelo IP público da sua instância EC2
# Exemplo: http://3.123.45.67  (sem barra no final)
VITE_BACKEND_URL=http://SEU_IP_EC2
