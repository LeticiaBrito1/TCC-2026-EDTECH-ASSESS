# =============================================================================
# .env.backend.example
# Copie para backend/.env.production e preencha os valores.
# =============================================================================

# Servidor
NODE_ENV=production
PORT=8787

# Frontend (coloque o mesmo IP do EC2)
FRONTEND_ORIGIN=http://SEU_IP_EC2

# Banco de dados — gerado pelo setup-server.sh
DATABASE_URL=postgresql://edtech_user:SENHA_GERADA@localhost:5432/edtech_db
PGSSL=false

# IA — Groq (gratuito)
AI_PROVIDER=groq
GROQ_API_KEY=gsk_SUACHAVEGROQ
GROQ_MODEL=llama-3.3-70b-versatile

# JWT — gere um valor aleatório forte (mínimo 32 caracteres)
# Execute: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=SUBSTITUA_POR_STRING_ALEATORIA_FORTE_DE_48_CHARS
JWT_EXPIRES_IN=12h

# E-mail — Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=edtech.assess@gmail.com
SMTP_PASS=jfqkmnpjnnsypccc
SMTP_FROM=EdTech Assess <edtech.assess@gmail.com>
APP_URL=http://SEU_IP_EC2
